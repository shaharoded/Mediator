<?xml version="1.0" encoding="UTF-8"?>
<pattern name="STOP_SGLT2_ON_ADMISSION_PATTERN" concept-type="local-pattern">
    <categories>Admission</categories>
    <description>Captures whether a prescribed SGLT2 inhibitor (high hypo/DKA risk) was withheld during admission. SGLT2 inhibitors should be held for the entire hospitalization, so ANY in-hospital administration is scored as non-adherence (asymptotically 0) and never administering is full adherence (1.0) - deliberately stricter than the 72h antidiabetic stop.</description>
    <!-- Attributes must be 1D. Can reference all tak types for complex cases. -->
    <derived-from>
        <attribute name="ADMISSION_EVENT" tak="event" ref="A1"/>
        <attribute name="SGLT2_HOME_BITZUA_CONTEXT" tak="context" idx="0" ref="C1"/>
        <attribute name="SGLT2_HOSPITAL_BITZUA" tak="raw-concept" idx="0" ref="E1"/>
    </derived-from>

    <!-- Rules always share "OR" relationship. To create more complex patterns, reference a pattern in a different pattern TAK -->
    <abstraction-rules>
        <rule>
            <!-- OPTIONAL: Contextual Information relevant if begins at / before the last event of the pattern starts-->
            <context>
                <attribute ref="C1">
                    <allowed-value equal="True"/>
                </attribute>
            </context>

            <!-- Relation between 2 KBTA objects -->
            <!-- max-distance is not the recommended distance, but the max acceptable one -->
            <temporal-relation how='before' max-distance='21d'>
                <anchor>
                    <attribute ref="A1">
                        <allowed-value equal="True"/>
                    </attribute>
                </anchor>
                <event select='first'>
                    <attribute ref="E1">
                        <allowed-value equal="True"/>
                    </attribute>
                </event>
            </temporal-relation>

            <!-- OPTIONAL: Compliance function to define fuzzy time window -->
            <compliance-function>
                <time-constraint-compliance>
                    <function name="id">
                        <!-- Rising ramp. A=0h so any recorded dose lands ON the ramp, never the
                             val<A branch that would wrongly return missing_score. B=C=D=25y flattens
                             the ramp so the score for the first in-hospital dose = time_from_admission / 25y:
                             even a dose at day 14 is 14/9125 = 0.0015, i.e. asymptotically 0 across the
                             whole possible stay. A patient never given SGLT2 is an unfulfilled anchor and
                             takes the trapez missing_score = 1.0 (full adherence). -->
                        <trapez trapezA="0h" trapezB="25y" trapezC="25y" trapezD="25y"/>
                    </function>
                </time-constraint-compliance>
            </compliance-function>
        </rule>
    </abstraction-rules>
</pattern>